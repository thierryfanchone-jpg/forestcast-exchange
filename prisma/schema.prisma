// IA Artisan — Schéma base de données
// Datasource: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  particulier
  artisan
  admin
}

enum SubscriptionPlan {
  free
  particulier
  premium
  artisan
}

enum DiagnosticStatus {
  pending
  analyzing
  completed
  failed
}

enum InputType {
  photo
  video
  audio
  text
}

enum UrgencyLevel {
  faible
  moyen
  eleve
  critique
}

enum ConfidenceLevel {
  faible
  moyenne
  elevee
}

enum Domain {
  electricite
  securite_incendie
  plomberie
  climatisation
  petits_travaux
  peinture
  cloisons
  montage_mobilier
  entretien_logement
  diagnostic_general
}

enum AIProvider {
  openai
  anthropic
  gemini
}

enum QuoteStatus {
  pending
  sent
  accepted
  rejected
  expired
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id               String           @id @default(cuid())
  email            String           @unique
  name             String?
  phone            String?
  role             UserRole         @default(particulier)
  plan             SubscriptionPlan @default(free)
  diagnosticsLeft  Int              @default(1)
  stripeCustomerId String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  diagnostics  Diagnostic[]
  artisanProfile ArtisanProfile?
  quoteRequests  QuoteRequest[]

  @@index([email])
}

model ArtisanProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  siret       String?
  domains     Domain[]
  city        String?
  postalCode  String?
  bio         String?
  rating      Float    @default(0)
  reviewCount Int      @default(0)
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  quoteRequests QuoteRequest[]
}

model Diagnostic {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        DiagnosticStatus @default(pending)
  inputType     InputType
  domain        Domain?
  userText      String?
  fileUrl       String?
  fileMimeType  String?
  aiProvider    AIProvider?
  aiModel       String?
  urgency       UrgencyLevel?
  confidence    ConfidenceLevel?
  result        Json?
  rawPrompt     String?
  processingMs  Int?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  report        Report?
  quoteRequests QuoteRequest[]
  mediaFiles    DiagnosticFile[]

  @@index([userId, createdAt])
  @@index([status])
}

model DiagnosticFile {
  id           String     @id @default(cuid())
  diagnosticId String
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  url          String
  mimeType     String
  sizeBytes    Int?
  order        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([diagnosticId])
}

model Report {
  id           String     @id @default(cuid())
  diagnosticId String     @unique
  diagnostic   Diagnostic @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  pdfUrl       String?
  summary      String?
  generatedAt  DateTime   @default(now())
}

model QuoteRequest {
  id             String         @id @default(cuid())
  diagnosticId   String
  diagnostic     Diagnostic     @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  artisanId      String?
  artisan        ArtisanProfile? @relation(fields: [artisanId], references: [id])
  status         QuoteStatus    @default(pending)
  message        String?
  artisanReply   String?
  estimatedPrice Float?
  scheduledAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([artisanId, status])
}

model StripeEvent {
  id          String   @id
  type        String
  payload     Json
  processedAt DateTime @default(now())
}

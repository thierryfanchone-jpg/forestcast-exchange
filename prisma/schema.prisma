// DepannIA — Prisma schema
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String       @id @default(cuid())
  email       String       @unique
  name        String?
  createdAt   DateTime     @default(now())
  diagnostics Diagnostic[]

  @@map("users")
}

model Diagnostic {
  id          String   @id @default(cuid())
  userId      String?
  category    String
  description String
  imageUrl    String?
  resultJson  Json?
  dangerLevel String?
  createdAt   DateTime @default(now())
  user        User?    @relation(fields: [userId], references: [id])

  @@map("diagnostics")
}

model LeadRequest {
  id          String   @id @default(cuid())
  category    String
  name        String
  phone       String
  email       String
  city        String
  description String
  imageUrl    String?
  status      String   @default("nouveau")
  createdAt   DateTime @default(now())

  @@map("lead_requests")
}

model ArtisanProfile {
  id               String   @id @default(cuid())
  companyName      String
  contactName      String
  trade            String
  siret            String?
  phone            String
  email            String
  city             String
  serviceAreas     String
  availability     String
  subscriptionType String
  status           String   @default("pending")
  createdAt        DateTime @default(now())

  @@map("artisan_profiles")
}

model KnowledgeGuide {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  category  String
  content   Json
  createdAt DateTime @default(now())

  @@map("knowledge_guides")
}

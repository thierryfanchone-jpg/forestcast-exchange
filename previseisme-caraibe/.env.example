# Copiez ce fichier vers .env à la racine si vous utilisez Docker Compose.
# Chaque service (frontend/backend) possède également son propre .env.example
# pour un développement local sans Docker.

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend ---
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+asyncpg://previseisme:previseisme@localhost:5432/previseisme_caraibe
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=15
HTTP_CONNECTOR_TIMEOUT_SECONDS=6.0
USGS_BASE_URL=https://earthquake.usgs.gov/fdsnws/event/1/query
EMSC_BASE_URL=https://www.seismicportal.eu/fdsnws/event/1/query
IPGP_BASE_URL=http://ws.ipgp.fr/fdsnws/event/1/query
FDSN_BASE_URL=https://service.iris.edu/fdsnws/event/1/query

# URL du backend FastAPI. Laisser vide pour rester en mode démonstration
# (données réalistes d'exemple, aucun backend requis).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Style de carte MapLibre. Par défaut : style gratuit "demotiles" (sans clé).
# En production, utilisez un style MapTiler/Mapbox/Stadia Maps pour plus de détail.
NEXT_PUBLIC_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json

# Supabase (authentification). Laisser vide pour rester en mode démonstration
# (authentification simulée, stockée uniquement dans le navigateur).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

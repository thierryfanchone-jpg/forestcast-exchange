# ─────────────────────────────────────────────────────────────
# TrustLayer AI — variables d'environnement
# Copiez ce fichier vers .env.local et remplissez les valeurs.
# Aucune clé secrète ne doit être committée dans le dépôt.
# ─────────────────────────────────────────────────────────────

# Supabase (authentification + base de données)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# IA & recherche web
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
TAVILY_API_KEY=

# Stripe (carte bancaire)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_UNLIMITED=

# PayPal Checkout
# PAYPAL_ENV: "sandbox" ou "live"
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Crypto — CRYPTO_PROVIDER: "coinbase" ou "nowpayments"
CRYPTO_PROVIDER=coinbase
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=

# Tarifs affichés (en euros, montant entier ou décimal)
NEXT_PUBLIC_PRICE_STARTER=9
NEXT_PUBLIC_PRICE_PRO=19
NEXT_PUBLIC_PRICE_UNLIMITED=39

# Crédits accordés par pack
PACK_STARTER_CREDITS=5
PACK_PRO_CREDITS=15

# URL publique de l'application
NEXT_PUBLIC_APP_URL=http://localhost:3000
